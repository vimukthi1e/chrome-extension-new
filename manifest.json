{
  "manifest_version": 3,
  "name": "Advanced Side Panel",
  "version": "1.1.1",
  "description": "Safe split side panel that shows two websites when framing is allowed.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Open Side Panel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
